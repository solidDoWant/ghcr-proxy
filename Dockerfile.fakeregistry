# The registry test double for e2e tests, built locally and loaded into kind
# (`make build-fakeregistry-image`); never released. Same base as the proxy image.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

ARG TARGETARCH
COPY build/images/${TARGETARCH}/fakeregistry /fakeregistry
USER 65532:65532
ENTRYPOINT ["/fakeregistry"]
